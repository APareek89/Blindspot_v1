# Blindspot — environment template. Copy to `.env` and fill. NEVER commit `.env`.
# Values here stay BLANK. Only presence is ever checked.

# --- providers (BYO keys; enable at least one — v1: Gemini, Groq, HF, Anthropic) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
HF_TOKEN=

# --- eval judge (reuse one of the above, e.g. gemini-1.5-flash or claude-haiku) ---
JUDGE_MODEL=

# --- data + cache ---
DATABASE_URL=
REDIS_URL=

# --- security (encrypts users' stored provider keys at rest; openssl rand -hex 32) ---
ENCRYPTION_KEY=

# --- ops (optional, free tiers) ---
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
COST_CAP_USD_PER_EVAL_RUN=1
