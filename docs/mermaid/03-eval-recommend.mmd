%% Blindspot — eval + recommend (PRD §3, §6): back-test a candidate then propose a swap
flowchart TD
  T["Trigger<br/>FUNCTION · add candidate OR run eval OR (Phase 5) version bump"]:::fn
  Q{"REDIS_URL set?<br/>FUNCTION"}:::dec
  EN["Enqueue eval job<br/>DATA · BullMQ bs:evals"]:::data
  IN["Run inline (dev)<br/>FUNCTION"]:::fn
  RUN["runEval: for each active golden example<br/>FUNCTION · loop"]:::fn
  CAND["Candidate output<br/>AGENT · candidate model via user key<br/>in: example.input · out: text + tokens + latency"]:::agent
  JUDGE["Judge score<br/>AGENT · JUDGE_MODEL via generateObject<br/>in: output vs reference + rubric · out: score 0..1"]:::agent
  AGG["Aggregate avg_score, latency, cost<br/>FUNCTION · write DATA · eval_runs"]:::data
  POL{"Policy: cheapest passing candidate cheaper than live?<br/>FUNCTION · score >= route.policy.minScore"}:::dec
  DUP{"Pending rec already exists for this target?<br/>FUNCTION"}:::dec
  REC["Create Recommendation + evidence<br/>DATA · recommendations status = pending<br/>fromScore/toScore + cost & latency delta"]:::data
  AUTO{"route.auto_approve ON?<br/>FUNCTION · default OFF"}:::dec
  APPLY["Apply swap: update routes.live_model<br/>FUNCTION · logged"]:::fn
  INBOX["Approvals inbox — USER approve or reject<br/>USER · approve applies swap, reject stores reason"]:::ask
  STOP["No recommendation<br/>FUNCTION · none warranted"]:::term

  T --> Q
  Q -- "yes" --> EN --> RUN
  Q -- "no" --> IN --> RUN
  RUN --> CAND --> JUDGE --> AGG --> POL
  POL -- "no" --> STOP
  POL -- "yes" --> DUP
  DUP -- "yes" --> STOP
  DUP -- "no" --> REC --> AUTO
  AUTO -- "yes" --> APPLY
  AUTO -- "no" --> INBOX
  INBOX -- "approve" --> APPLY

  classDef agent fill:#dbeafe,stroke:#2563eb,color:#0b2a5b;
  classDef fn fill:#dcfce7,stroke:#16a34a,color:#052e16;
  classDef dec fill:#f3e8ff,stroke:#9333ea,color:#2a0a4a;
  classDef data fill:#ede9fe,stroke:#7c3aed,color:#2a0a4a;
  classDef ask fill:#cffafe,stroke:#0891b2,color:#083344;
  classDef term fill:#e5e7eb,stroke:#6b7280,color:#111827;
